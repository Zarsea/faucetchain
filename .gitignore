# Solana keypairs — private keys, never committed
relayer.json
funder.json
*-keypair.json
id.json
treasury.json

# Backups pontuais feitos antes de uma escrita no livro-razao ou numa
# atualizacao de dependencia. Ficam em disco para reverter, nunca no historico.
*.antes-*
*.db.antes-*

# Credencial do no, ao lado do id dele. Nunca versionada.
.node_token
mining-node/.node_token

# A identidade de um no e o par (.node_id, .node_token), e um segundo no na
# mesma maquina usa .node_id.2 / .node_token.2. As regras acima davam o nome
# exato, entao os sufixados escaparam e um token foi parar num commit. Glob
# cobre qualquer sufixo.
.node_id*
.node_token*
mining-node/.node_id*
mining-node/.node_token*

