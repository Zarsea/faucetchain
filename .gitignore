# Solana keypairs — private keys, never committed
relayer.json
funder.json
*-keypair.json
id.json
treasury.json

# Backups pontuais feitos antes de uma escrita no livro-razao ou numa
# atualizacao de dependencia. Ficam em disco para reverter, nunca no historico.
*.antes-*
*.db.antes-*

# Credencial do no, ao lado do id dele. Nunca versionada.
.node_token
mining-node/.node_token

# A identidade de um no e o par (.node_id, .node_token), e um segundo no na
# mesma maquina usa .node_id.2 / .node_token.2. As regras acima davam o nome
# exato, entao os sufixados escaparam e um token foi parar num commit. Glob
# cobre qualquer sufixo.
.node_id*
.node_token*
mining-node/.node_id*
mining-node/.node_token*

# Regra de permissao pessoal: libera o script de aposentadoria do ledger.
# Nao vai para o repositorio -- liberar comando destrutivo e decisao de quem
# opera a maquina, nao do projeto.
.claude/settings.local.json

# Skills instalados por `npx skills add`. Sao ferramenta de quem edita, nao o
# produto: 2,3 MB de referencias mais um binario que o lancador baixa no
# primeiro uso. Os symlinks de .claude/skills apontam para caminho absoluto
# desta maquina, entao nao servem para mais ninguem.
# skills-lock.json fica de fora de proposito: ele registra quais skills o
# projeto usa, e commitar isso e decisao de quem mantem, nao minha.
.agents/
.claude/skills/

# Saida do playwright-cli: snapshots e logs de console de cada sessao de
# navegador. Diagnostico de um momento, nao do projeto.
.playwright-cli/

# Pacote temporario do test_connected_signer.mjs; o teste o apaga sozinho.
.sw-test.mjs
